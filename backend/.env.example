# Скопируйте в .env и заполните нужное. Без единого значения система работает: ИИ-разбор идет по правилам.

# ИИ-разбор обращений и совещаний. Достаточно одного ключа; если заданы оба - используется Claude.
# Без ключа работают правила.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1   # или адрес локальной модели с OpenAI-совместимым API
# AI_MODE=rules   # принудительно отключить модель

# Распознавание речи (локально). Модели: small, medium, large-v3. Кэш моделей - HF_HOME.
WHISPER_MODEL=medium
# HF_HOME=D:\models\hf

# Telegram-бот для сотрудников (токен от @BotFather)
TELEGRAM_BOT_TOKEN=
# Telegram Mini App: публичный https-адрес этого приложения. Пусто - бот работает только диалогом в чате.
# WEBAPP_URL=https://otklik.example.kz
# Часовой пояс компании (смещение от UTC) и час утренней сводки ответственным в боте
# TZ_OFFSET_HOURS=5
# DIGEST_HOUR=9

# Бот в мессенджере MAX (токен: business.max.ru -> Чат-боты -> Настройки)
MAX_BOT_TOKEN=
# Новый адрес API MAX требует корневой сертификат Минцифры. Без MAX_CA_FILE бот сам перейдет на прежний адрес.
# MAX_API_URL=https://platform-api2.max.ru
# MAX_CA_FILE=D:\certs\russian_trusted_root_ca.pem

# Почтовый ящик обратной связи (IMAP)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# Быстрый вход под демо-ролями на экране логина (в рабочей установке - 0)
DEMO_LOGIN=1
